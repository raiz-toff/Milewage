{
	admin off
	auto_https off
	# The host's `tailscale serve` reaches Caddy through the Docker gateway of the stack's network
	# (plan 19 section 3.1). Trusting that one address keeps its X-Forwarded-Proto (https),
	# X-Forwarded-Host and X-Forwarded-For; any other sender's are replaced as before. Caddy is
	# published on loopback only, so nothing outside the host can reach it to forge them.
	# MILEWAGE_TRUSTED_PROXIES adds the owner's own reverse proxy (addresses or CIDRs separated by
	# spaces, set in .env), so its https survives without editing this file (install.md section 7).
	servers {
		trusted_proxies static {$MILEWAGE_PROXY_GATEWAY:172.29.88.1}/32 {$MILEWAGE_TRUSTED_PROXIES}
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
		# What the web client may load (08 response headers, decision 1.11). Only the OpenFreeMap
		# basemap comes from elsewhere: its style, tiles, sprites and glyphs are all on
		# tiles.openfreemap.org. MapLibre starts its worker from /assets (worker-src) and draws
		# sprites from blob: URLs. Radix's scroll lock adds a <style> element and components set
		# style attributes, hence 'unsafe-inline' for styles (never for scripts; the built
		# index.html has no inline script). The service worker and the manifest are same-origin.
		# A build with VITE_MAP_STYLE_URL pointing at another host must add that host (and every
		# host its style names for tiles, sprites and glyphs) to img-src and connect-src, or the
		# map shows the plain background; infra/docs/install.md section 8.
		# "?" keeps a policy the API sets itself (platform logos: default-src 'none'; sandbox).
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	# HSTS only when the request reached the host over https (tailscale serve sets
	# X-Forwarded-Proto: https, kept because it is a trusted proxy). Plain http on the host or
	# the LAN gets none, so it keeps working there (browsers also ignore HSTS over http).
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000"

	# The API container publishes no port.
	# Body limits are set per handler, because a site-level limit would also cap the restore route.
	# Restore uploads a whole backup (08 section 7.3: 512 MiB on this route only); the rest keep 2 MiB.
	@restore path /api/v1/setup/restore
	handle @restore {
		request_body {
			max_size 512MB
		}
		reverse_proxy api:3000
	}

	@api path /api/* /healthz
	handle @api {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:3000
	}
	# The installable web app's files (plan 27): the manifest is checked again on every visit, so
	# a change is seen at once; Go's MIME table has no .webmanifest. Icons rarely change.
	handle /manifest.webmanifest {
		root * /srv/web
		header Cache-Control "no-cache"
		header Content-Type "application/manifest+json"
		file_server
	}
	# The service worker, and the page it keeps for offline starts (it fetches /index.html by
	# name): always asked for again, so a new version is found (plan 27 section 4.2).
	@fresh path /sw.js /index.html
	handle @fresh {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}
	@icons path /favicon.ico /favicon.svg /favicon-light.svg /favicon-dark.svg /apple-touch-icon.png /icons/*
	handle @icons {
		root * /srv/web
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# The web client (apps/web, built into /srv/web by the caddy image target). Only its own
	# screens fall back to index.html, so any other unknown path is still a 404.
	# Keep this list in step with apps/web/src/screens.tsx.
	@spa path / /pair /app /privacy /onboarding /onboarding/* /dashboard /shifts /shifts/* /expenses /analytics /goals /tax /vehicles /odometer /exports /devices /backups /settings /settings/* /help /help/*
	handle @spa {
		root * /srv/web
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
