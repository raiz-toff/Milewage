node_modules/
dist/
coverage/
*.log
.env
.DS_Store
*.tsbuildinfo
# Claude Code's local state stays out; the project skills under .claude/skills/ are part of the repo.
.claude/*
!.claude/skills/
# Expo prebuild output (regenerated by scripts/phone-release-build.sh)
apps/phone/android/
apps/phone/ios/
apps/phone/.expo/
.expo/
# Gradle output written inside the autolinked native module
apps/phone/native/**/android/build/
apps/phone/native/**/android/.gradle/
# VM test output (raw JSON, CSV, copied backups)
infra/vm-tests/artifacts/
# Local dev data for `npm run dev` (scripts/dev.mjs)
.dev/
.dev.before-integrate-*/
# Signing keys never go in git (scripts/phone-keystore.sh writes them to ~/.milewage)
*.keystore
*.jks
