<?xml version="1.0" encoding="utf-8"?>
<!-- Notification text of the tracking layer, in the MileWage voice (.claude/skills/milewage-design,
     references/voice-and-formats.md): short, plain, one way forward, no exclamation marks. The
     running-shift notification's own text is built in :core (ShiftNotice, ported from the Expo app). -->
<resources>
    <!-- Channels, as the driver sees them in the phone's notification settings. -->
    <string name="tracking_channel_shift">Shift in progress</string>
    <string name="tracking_channel_shift_description">Distance and time of the running shift.</string>
    <string name="tracking_channel_prompts">Shift reminders</string>
    <string name="tracking_channel_prompts_description">Checks on a shift that has not moved for a long time.</string>
    <string name="tracking_channel_problems">Recording problems</string>
    <string name="tracking_channel_problems_description">Tells you when MileWage cannot record a shift and what to do.</string>

    <string name="tracking_starting_title">Shift in progress</string>

    <string name="tracking_end_shift">End shift</string>

    <string name="tracking_nudge_title">Still on shift?</string>
    <plurals name="tracking_nudge_text">
        <item quantity="one">You have not moved for %d minute.</item>
        <item quantity="other">You have not moved for %d minutes.</item>
    </plurals>
    <string name="tracking_nudge_keep">Keep going</string>

    <string name="tracking_problem_shift_title">Your shift is not recording.</string>
    <string name="tracking_problem_shift_text">Open MileWage to keep recording it.</string>
    <string name="tracking_problem_end_title">The shift is still running.</string>
    <string name="tracking_problem_end_text">Open MileWage to end it.</string>
</resources>
