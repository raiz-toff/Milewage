{
  "name": "@milewage/phone",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./native"
    }
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "conformance:fixtures": "esbuild scripts/gen-conformance-fixtures.ts --bundle --platform=node --format=esm --outfile=scripts/.gen.mjs --log-level=warning && node scripts/.gen.mjs && rm scripts/.gen.mjs && prettier --write src/conformance/fixtures.json"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.tsx",
      "<rootDir>/test/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@milewage/.*|lucide-react-native|nativewind|react-native-css-interop|@rn-primitives/.*))"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-plugin-syntax-hermes-parser": "0.36.1",
    "hermes-parser": "0.36.1",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@milewage/shared": "*",
    "@milewage/track-engine": "*",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@rn-primitives/slot": "1.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "fflate": "^0.8.2",
    "lucide-react-native": "1.21.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.6.0"
  }
}
