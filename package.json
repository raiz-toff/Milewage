{
  "name": "milewage",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "MILEWAGE_COVERAGE=1 vitest run --coverage",
    "build:server": "node scripts/build-server.mjs",
    "smoke:docker": "bash infra/docker/smoke.sh",
    "typecheck:phone": "npm run typecheck -w apps/phone",
    "typecheck:web": "npm run typecheck -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test:phone": "npm test -w apps/phone",
    "verify": "npm run typecheck && npm run typecheck:phone && npm run typecheck:web && npm run lint && npm run version:check && npm run openapi:check && npm run test && npm run test:phone",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "openapi:generate": "node scripts/openapi-generate.mjs generate",
    "openapi:check": "node scripts/openapi-generate.mjs check && node scripts/openapi-generate.mjs lint"
  },
  "overrides": {
    "hermes-parser": "0.36.1",
    "babel-plugin-syntax-hermes-parser": "0.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
