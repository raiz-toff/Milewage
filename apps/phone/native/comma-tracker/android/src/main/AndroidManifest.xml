<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Permissions are listed once, in apps/phone/app.json (09 section 5.3). This module declares
       none: no battery-optimization exemption, no overlay, no boot receiver. -->
  <application>
    <service
      android:name="expo.modules.commatracker.LocationTrackingService"
      android:enabled="true"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="location" />

    <!-- Receives Activity Transition (movement vs. still) callbacks to gate the GPS radio. -->
    <receiver
      android:name="expo.modules.commatracker.ActivityTransitionReceiver"
      android:enabled="true"
      android:exported="false" />
  </application>
</manifest>
