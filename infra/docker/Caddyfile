{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# The static web client and tiles are added by later PRs. The API container publishes no port.
	# Body limits are set per handler, because a site-level limit would also cap the restore route.
	# Restore uploads a whole backup (08 section 7.3: 512 MiB on this route only); the rest keep 2 MiB.
	@restore path /api/v1/setup/restore
	handle @restore {
		request_body {
			max_size 512MB
		}
		reverse_proxy api:3000
	}

	@api path /api/* /healthz
	handle @api {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:3000
	}
	handle {
		respond "Not found" 404
	}
}
