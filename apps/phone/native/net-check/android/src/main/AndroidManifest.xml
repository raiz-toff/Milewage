<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Reading whether this phone's traffic goes through a VPN (Tailscale); no prompt. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Android 11+ hides other apps unless they are named here: only Tailscale is (plan 19 §3.5). -->
  <queries>
    <package android:name="com.tailscale.ipn" />
  </queries>
</manifest>
