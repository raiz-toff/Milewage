<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talking to the driver's server, and noticing when the network comes back to send. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ hides other apps unless they are named here: only Tailscale is (plan 19 section 3.5). -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>
</manifest>
