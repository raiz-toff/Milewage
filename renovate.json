{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "schedule:weekly"],
  "packageRules": [
    {
      "description": "One weekly pull request for every minor and patch update; majors stay separate.",
      "groupName": "minor and patch updates",
      "groupSlug": "minor-patch",
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
